{
  "datasets": [
    {
      "name": "ds_fleet",
      "displayName": "Fleet health",
      "queryLines": [
        "SELECT machine_id, model, region, dealer, customer_name, phone, health_status, ",
        "CASE health_status WHEN 'Critical' THEN 1 WHEN 'Watch' THEN 2 ELSE 3 END AS status_rank, ",
        "CASE WHEN health_status = 'Healthy' THEN 1 ELSE 0 END AS is_healthy, ",
        "CASE WHEN health_status = 'Critical' THEN 1 ELSE 0 END AS is_critical, ",
        "last_hydraulic_temp_c, avg_hydraulic_temp_c, fault_count, last_reading_at ",
        "FROM machine_health ",
        "ORDER BY status_rank, last_hydraulic_temp_c DESC "
      ]
    },
    {
      "name": "ds_cost",
      "displayName": "Demo cost",
      "queryLines": [
        "WITH pipelines AS ( ",
        "  SELECT pipeline_id, max_by(name, change_time) AS pipeline_name FROM system.lakeflow.pipelines GROUP BY pipeline_id ",
        ") ",
        "SELECT u.usage_date, u.billing_origin_product AS product, ",
        "  COALESCE(u.custom_tags['component'], p.pipeline_name, u.billing_origin_product) AS component, ",
        "  u.usage_quantity AS dbus, ",
        "  COALESCE(u.usage_quantity * lp.pricing.effective_list.default, 0) AS list_cost_usd ",
        "FROM system.billing.usage u ",
        "LEFT JOIN pipelines p ON u.usage_metadata.dlt_pipeline_id = p.pipeline_id ",
        "LEFT JOIN system.billing.list_prices lp ON u.sku_name = lp.sku_name ",
        "  AND u.usage_start_time >= lp.price_start_time ",
        "  AND (lp.price_end_time IS NULL OR u.usage_start_time < lp.price_end_time) ",
        "WHERE u.custom_tags['project'] = 'fleet-l100' ",
        "  AND u.usage_date BETWEEN :date_range.min AND :date_range.max "
      ],
      "parameters": [
        {
          "keyword": "date_range",
          "dataType": "DATE",
          "complexType": "RANGE",
          "defaultSelection": {
            "range": {
              "dataType": "DATE",
              "min": {
                "value": "now/d"
              },
              "max": {
                "value": "now/d"
              }
            }
          },
          "displayName": "Usage date"
        }
      ]
    }
  ],
